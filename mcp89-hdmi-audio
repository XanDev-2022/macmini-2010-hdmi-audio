#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""HDMI audio for the NVIDIA MCP89 / GeForce 320M (Mac mini 2010 and friends).

The nouveau driver programs HDMI on this chip with audio clock regeneration
(ACR) switched off, so TVs, monitors and receivers receive no audio. This
daemon watches the HDMI output and, whenever the driver (re)programs it,
re-applies a working setup:

  * 2-channel Audio InfoFrame with a correct checksum
  * ACR enabled, with CTS/N values computed from the *live* pixel clock
  * DP audio disabled on the HDMI output resource (SOR)

Register sequence from the reverse engineering in
https://github.com/obhasashare2024-namo/nouveau-mcp89-hdmi-audio (GPLv2).

Usage:  mcp89-hdmi-audio            run the watcher (as root, via systemd)
        mcp89-hdmi-audio --status   print diagnostics and exit
        mcp89-hdmi-audio --once     apply once and exit
"""
import ctypes, glob, mmap, os, re, subprocess, sys, time

SUPPORTED_DEVICES = {0x08a0, 0x08a2, 0x08a3, 0x08a4, 0x08a5}  # MCP89 / GeForce 320M
MCP89_CHIPSET = 0xaf
POLL_SECONDS = 2
SETTLE_SECONDS = 2

REG_BASE, REG_SIZE = 0x610000, 0x10000      # display engine window in BAR0
SOR_STRIDE = 0x800
HDMI_CTRL, HDMI_ENABLE = 0x61c5a4, 1 << 30
INFOFRAME_CTRL, INFOFRAME_HDR, INFOFRAME_PB0, INFOFRAME_PB4 = 0x61c500, 0x61c508, 0x61c50c, 0x61c510
ACR_CTRL, ACR_TABLE = 0x61c568, 0x61c56c    # table: (CTS, N) pairs, 8 bytes apart
DP_AUDIO = 0x61c1e0
AUDIO_CNTRL = 0x61733c

# (sample rate, N) per the HDMI spec's recommended values
RATES = [(32000, 4096), (44100, 6272), (48000, 6144), (88200, 12544),
         (96000, 12288), (176400, 25088), (192000, 24576)]
MODE_RE = re.compile(r"#\d+ \S+ \S+(?: \d+){8} (\d+) flags")


def log(msg):
    print(msg, flush=True)


def find_gpu():
    for dev in glob.glob("/sys/bus/pci/devices/*"):
        try:
            vendor = int(open(f"{dev}/vendor").read(), 16)
            device = int(open(f"{dev}/device").read(), 16)
        except OSError:
            continue
        if vendor == 0x10de and device in SUPPORTED_DEVICES:
            return dev, device
    return None, None


def find_hdmi_connector():
    paths = sorted(glob.glob("/sys/class/drm/card*-HDMI-A-*"))
    return paths[0] if paths else None


class Regs:
    def __init__(self, gpu):
        fd = os.open(f"{gpu}/resource0", os.O_RDWR | os.O_SYNC)
        self.boot = mmap.mmap(fd, mmap.PAGESIZE, offset=0)
        self.mm = mmap.mmap(fd, REG_SIZE, offset=REG_BASE)

    def chipset(self):
        boot0 = ctypes.c_uint32.from_buffer(self.boot, 0).value   # PMC_BOOT_0
        return (boot0 >> 20) & 0x1ff

    def rd(self, a):
        return ctypes.c_uint32.from_buffer(self.mm, a - REG_BASE).value

    def wr(self, a, v):
        ctypes.c_uint32.from_buffer(self.mm, a - REG_BASE).value = v & 0xFFFFFFFF

    def mask(self, a, m, v):
        self.wr(a, (self.rd(a) & ~m) | v)


def hdmi_sor(regs):
    for i in range(4):
        if regs.rd(HDMI_CTRL + i * SOR_STRIDE) & HDMI_ENABLE:
            return i * SOR_STRIDE
    return None


def pixel_clock_khz():
    """Clock of the active CRTC mode, from modetest's CRTC listing."""
    out = subprocess.run(["modetest", "-M", "nouveau", "-p"],
                         capture_output=True, text=True).stdout
    crtcs = out.split("CRTCs:", 1)[-1].split("Planes:", 1)[0]
    for m in MODE_RE.finditer(crtcs):
        if int(m.group(1)) > 0:
            return int(m.group(1))
    return None


def acr_table(clock_khz):
    # CTS = f_TMDS * N / (128 * fs)
    return [(clock_khz * 1000 * n // (128 * fs), n) for fs, n in RATES]


def is_applied(regs, soff, clock_khz):
    if not regs.rd(ACR_CTRL + soff) & 1 or regs.rd(INFOFRAME_PB0 + soff) != 0x170:
        return False
    cts_48k = acr_table(clock_khz)[2][0]
    return regs.rd(ACR_TABLE + soff + 2 * 8) == cts_48k << 8


def apply(regs, soff, clock_khz):
    # Audio InfoFrame: CC=1 (2 channels), checksum 0x70
    regs.mask(INFOFRAME_CTRL + soff, 1, 0)
    regs.wr(INFOFRAME_HDR + soff, 0x000a0184)
    regs.wr(INFOFRAME_PB0 + soff, 0x00000170)
    regs.wr(INFOFRAME_PB4 + soff, 0x00000000)
    regs.mask(INFOFRAME_CTRL + soff, 1, 1)
    # Audio clock regeneration
    regs.mask(ACR_CTRL + soff, 1, 1)
    for i, (cts, n) in enumerate(acr_table(clock_khz)):
        regs.wr(ACR_TABLE + soff + i * 8, cts << 8)
        regs.wr(ACR_TABLE + soff + i * 8 + 4, 0x80000000 | n)
    regs.mask(DP_AUDIO + soff, 1, 0)
    # Audio reset, as the driver does after HDMI setup
    regs.mask(AUDIO_CNTRL, 0x00100000, 0x00100000)
    regs.mask(AUDIO_CNTRL, 0x10000000, 0x10000000)
    regs.mask(AUDIO_CNTRL, 0x00100000, 0x00000000)


def status(regs, connector):
    log(f"connector:   {connector} = {open(f'{connector}/status').read().strip()}")
    soff = hdmi_sor(regs)
    if soff is None:
        log("HDMI SOR:    none active")
        return
    clock = pixel_clock_khz()
    log(f"HDMI SOR:    SOR{soff // SOR_STRIDE}")
    log(f"pixel clock: {clock} kHz")
    log(f"applied:     {bool(clock) and is_applied(regs, soff, clock)}")
    for name, a in [("INFOFRAME_CTRL", INFOFRAME_CTRL), ("INFOFRAME_PB0", INFOFRAME_PB0),
                    ("ACR_CTRL", ACR_CTRL), ("ACR_CTS_48K", ACR_TABLE + 16),
                    ("ACR_N_48K", ACR_TABLE + 20), ("HDMI_CTRL", HDMI_CTRL),
                    ("DP_AUDIO", DP_AUDIO)]:
        log(f"  {name:<15} 0x{a + soff:06x} = 0x{regs.rd(a + soff):08x}")
    log(f"  {'AUDIO_CNTRL':<15} 0x{AUDIO_CNTRL:06x} = 0x{regs.rd(AUDIO_CNTRL):08x}")
    for eld in sorted(glob.glob("/proc/asound/card*/eld#*")):
        text = open(eld).read()
        if re.search(r"monitor_present\s+1", text):
            name = re.search(r"monitor_name\s+(.*)", text)
            log(f"ELD:         {eld}: {name.group(1).strip() if name else '?'}")


def try_apply(regs, connector, settle):
    if open(f"{connector}/status").read().strip() != "connected":
        return
    soff = hdmi_sor(regs)
    clock = pixel_clock_khz() if soff is not None else None
    if not clock or is_applied(regs, soff, clock):
        return
    if settle:
        time.sleep(SETTLE_SECONDS)      # let the modeset finish
        clock = pixel_clock_khz()
        if not clock:
            return
    apply(regs, soff, clock)
    log(f"applied on SOR{soff // SOR_STRIDE} at {clock} kHz")


def main():
    if os.geteuid() != 0:
        sys.exit("must run as root")
    gpu, device = find_gpu()
    if not gpu:
        sys.exit("no MCP89 / GeForce 320M found; refusing to touch other GPUs")
    regs = Regs(gpu)
    if regs.chipset() != MCP89_CHIPSET:
        sys.exit(f"chipset 0x{regs.chipset():x} is not MCP89 (0xaf); refusing to continue")
    connector = find_hdmi_connector()
    if not connector:
        sys.exit("no HDMI connector found")

    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--status":
        log(f"gpu:         {os.path.basename(gpu)} [10de:{device:04x}] chipset 0x{regs.chipset():x}")
        status(regs, connector)
        return
    if arg == "--once":
        try_apply(regs, connector, settle=False)
        return

    log(f"watching {connector} on {os.path.basename(gpu)}")
    while True:
        try:
            try_apply(regs, connector, settle=True)
        except Exception as e:
            log(f"error: {e}")
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    main()
